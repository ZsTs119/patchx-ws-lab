{
  "id": "full-duplex-tts-playback-artifact-guard",
  "name": "全双工 TTS 播放破音防护",
  "area": "音频",
  "version": "1.0.0",
  "description": "验证全双工下行播放启用 headroom、limiter、边界平滑和 late-frame 防护后，句中 underflow、削波、边界跳变和旧帧串入是否受控。",
  "actions": [],
  "scenarios": [
    {
      "id": "module.full-duplex-tts-playback-artifact-guard",
      "label": "全双工 TTS 播放破音防护",
      "description": "使用外部默认全双工播放策略触发一轮日语 TTS，验收下行播放质量指标。",
      "stability": "manual-audio",
      "suite": "feature",
      "auto_connect": false,
      "steps": [
        { "action": "set_audio_profile", "profile": { "format": "opus", "sample_rate": 24000, "frame_duration": 60 } },
        { "action": "set_playback_profile", "profile": { "format": "pcm", "sample_rate": 24000, "frame_duration": 60 } },
        { "action": "set_mic_constraints", "constraints": { "echo_cancellation": true, "noise_suppression": false, "auto_gain_control": false } },
        {
          "action": "set_playback_tuning",
          "tuning": {
            "initial_buffer_ms": 180,
            "full_duplex_initial_buffer_ms": 420,
            "resume_lead_ms": 120,
            "low_watermark_ms": 180,
            "max_buffer_ms": 1600,
            "output_gain": 0.82,
            "limiter_enabled": true,
            "limiter_threshold_db": -6,
            "limiter_ratio": 8,
            "boundary_smoothing_ms": 3,
            "boundary_jump_threshold": 0.35,
            "artifact_guard_enabled": true
          }
        },
        { "action": "connect_hello", "wait_session": true, "timeout_ms": 12000 },
        { "action": "unlock_playback" },
        { "action": "start_mic" },
        { "action": "wait", "ms": 300 },
        {
          "action": "send_text",
          "text": "日本語で自然に一文だけ返してください。星雲の奥でまだ眠っている仲間の話を、やさしい声で短く伝えてください。"
        },
        { "action": "wait_ws", "type": "tts", "state": "sentence_start", "timeout_ms": 30000 },
        { "action": "expect_binary", "timeout_ms": 20000 },
        {
          "action": "expect_playback_quality",
          "timeout_ms": 12000,
          "min_received_frames": 1,
          "max_mid_sentence_underflow": 1,
          "max_dropped_frames": 5,
          "max_decode_ms": 120,
          "max_clipping_ratio": 0.01,
          "max_boundary_jump": 0.7,
          "max_late_frames": 0,
          "max_profile_mismatch": 0,
          "expect_artifact_guard": true,
          "mic_active": true
        },
        { "action": "wait_ws", "type": "tts", "state": "stop", "timeout_ms": 50000 },
        {
          "action": "expect_playback_quality",
          "timeout_ms": 2000,
          "min_received_frames": 1,
          "max_mid_sentence_underflow": 1,
          "max_clipping_ratio": 0.01,
          "max_late_frames": 0,
          "max_profile_mismatch": 0,
          "expect_artifact_guard": true
        },
        { "action": "stop_mic", "wait_ms": 200 },
        { "action": "expect_no_ws", "type": "goodbye", "timeout_ms": 1000 }
      ]
    }
  ]
}
